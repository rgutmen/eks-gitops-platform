# Values for this AWS account. Generate with: make k8s-config
# (reads the OpenTofu outputs). The real config.env is git-ignored.

AWS_REGION=eu-west-1
CATALOG_TABLE=sftp-platform-catalog
ALLOWED_BUCKETS=sftp-platform-inbound-111111111111
TRANSFER_SERVER_ID=s-0123456789abcdef0
TRANSFER_USER_ROLE=arn:aws:iam::111111111111:role/sftp-platform-transfer-user-access
TRANSFER_VPC_ID=vpc-0123456789abcdef0
TRANSFER_ENDPOINT_ID=vpce-0123456789abcdef0
SFTP_HOSTNAMES=203.0.113.10,203.0.113.11
# Reached over kubectl port-forward (plain HTTP on localhost).
COOKIE_SECURE=false
